#!/bin/sh
# NovaOS Installer init script  – Windows XP-style wizard (1.00 26Q4 Build 26110.0000)

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

# ── Virtual filesystems ────────────────────────────────────────────────────
mount -t devtmpfs devtmpfs /dev 2>/dev/null || mount -t tmpfs tmpfs /dev
mkdir -p /dev/pts /dev/shm /proc /sys /run /tmp /mnt /target
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devpts devpts /dev/pts

# ── ANSI helpers (pure escape characters - no echo -e dependency) ──────────
ESC="$(printf '\033')"
BOLD="${ESC}[1m"
DIM="${ESC}[2m"
ITALIC="${ESC}[3m"
UNDER="${ESC}[4m"
BLINK="${ESC}[5m"
REV="${ESC}[7m"
RESET="${ESC}[0m"

# XP colour palette
BLUE="${ESC}[44;37m"        # white on blue  (XP title)
LTBLUE="${ESC}[104;97m"     # bright white on bright blue
DKBLUE="${ESC}[34m"         # dark blue text
GREEN="${ESC}[32m"
LGREEN="${ESC}[92m"
CYAN="${ESC}[36m"
YELLOW="${ESC}[33m"
RED="${ESC}[31m"
WHITE="${ESC}[37m"
GRAY="${ESC}[90m"
BWHITE="${ESC}[97m"

# ── XP drawing helpers ────────────────────────────────────────────────────
xp_header() {
  clear
  printf "%s%s\n" "${LTBLUE}" "${BOLD}"
  printf "  ========================================================================\n"
  printf "  |  NOVAOS 1.00 26Q4 (Build 26110.0000)  |                            |\n"
  printf "  ========================================================================\n"
  printf "%s\n" "${RESET}"
  printf "%s%s\n" "${BLUE}" "${BOLD}"
  printf "  Windows XP-style Setup Wizard\n"
  printf "%s\n" "${RESET}"
  printf "\n"
}

xp_banner() {
  printf "%s%s\n" "${LTBLUE}" "${BOLD}"
  printf "  ┌──────────────────────────────────────────────────────────────────────┐\n"
  printf "  │  %-68s│\n" "$1"
  printf "  └──────────────────────────────────────────────────────────────────────┘\n"
  printf "%s\n" "${RESET}"
}

xp_section() {
  printf "%s%s  ► %s%s\n" "${BOLD}" "${DKBLUE}" "$1" "${RESET}"
  printf "  %s──────────────────────────────────────────────────────────────%s\n" "${DIM}" "${RESET}"
}

xp_item() {
  printf "    %-30s %s\n" "$1" "$2"
}

xp_ok()   { printf "    %s[  OK  ]%s  %s\n" "${LGREEN}" "${RESET}" "$1"; }
xp_warn() { printf "    %s[ WARN ]%s  %s\n" "${YELLOW}" "${RESET}" "$1"; }
xp_fail() { printf "    %s[ FAIL ]%s  %s\n" "${RED}" "${RESET}" "$1"; }
xp_info() { printf "    %s[ INFO ]%s  %s\n" "${CYAN}" "${RESET}" "$1"; }

progress_bar() {
  local pct=$1 label=$2
  local filled=$((pct * 50 / 100))
  local empty=$((50 - filled))
  printf "  [%s%s]  %3d%%  %s\r" "$(printf '#%.0s' $(seq 1 $filled 2>/dev/null))" \
    "$(printf ' %.0s' $(seq 1 $empty 2>/dev/null))" "$pct" "$label"
}

# ── Load storage modules ───────────────────────────────────────────────────
modprobe ahci 2>/dev/null || true
modprobe isofs 2>/dev/null || true
modprobe pata_oldpiix 2>/dev/null || true
modprobe pata_mpiix 2>/dev/null || true
modprobe nvme 2>/dev/null || true
modprobe virtio_blk 2>/dev/null || true
modprobe virtio_scsi 2>/dev/null || true
sleep 1

# ═══════════════════════════════════════════════════════════════════════════
# PAGE 1 – WELCOME
# ═══════════════════════════════════════════════════════════════════════════
xp_header
xp_banner "Welcome to Nova OS 1.00 26Q4 Setup"
printf "  %sThis wizard will guide you through installing NovaOS on your%s\n" "${BOLD}" "${RESET}"
printf "  %scomputer. The process has five easy steps:%s\n" "${BOLD}" "${RESET}"
printf "\n"
printf "    %s1%s  Hardware detection\n" "${LGREEN}" "${RESET}"
printf "    %s2%s  Resource configuration  (RAM & storage)\n" "${LGREEN}" "${RESET}"
printf "    %s3%s  Select target disk\n" "${LGREEN}" "${RESET}"
printf "    %s4%s  Confirmation & dual BIOS/UEFI installation\n" "${LGREEN}" "${RESET}"
printf "    %s5%s  Complete\n" "${LGREEN}" "${RESET}"
printf "\n"
printf "  %sTo cancel at any time, type 'q' and press Enter.%s\n" "${GRAY}" "${RESET}"
printf "\n"
printf "  Press ENTER to begin setup... "
read -r dummy

# ═══════════════════════════════════════════════════════════════════════════
# PAGE 2 – HARDWARE DETECTION
# ═══════════════════════════════════════════════════════════════════════════
xp_header
xp_banner "Step 1 of 5 - Detecting Hardware"

xp_section "Processor"
CPU_INFO=$(grep -m1 "model name" /proc/cpuinfo 2>/dev/null | cut -d: -f2 | xargs)
[ -z "$CPU_INFO" ] && CPU_INFO="Unknown Processor"
xp_ok "$CPU_INFO"

xp_section "Memory"
INSTALLED_RAM_KB=$(grep MemTotal /proc/meminfo 2>/dev/null | awk '{print $2}')
[ -z "$INSTALLED_RAM_KB" ] && INSTALLED_RAM_KB=1048576
INSTALLED_RAM_MB=$((INSTALLED_RAM_KB / 1024))
INSTALLED_RAM_GB=$((INSTALLED_RAM_MB / 1024))
if [ "$INSTALLED_RAM_GB" -ge 1 ]; then
  xp_ok "${INSTALLED_RAM_MB} MB  (${INSTALLED_RAM_GB} GB)  physical RAM detected"
else
  xp_ok "${INSTALLED_RAM_MB} MB  physical RAM detected"
fi

xp_section "Storage Controllers"
for ctrl in ahci ata_piix pata_mpiix nvme virtio_blk; do
  lsmod 2>/dev/null | grep -q "^${ctrl}" && xp_ok "Controller: $ctrl" || true
done

xp_section "Locate NovaOS Images"
IMAGE_PATH=""
EFIBOOT_PATH=""

for try_path in /novaos.img /boot/novaos.img; do
  [ -f "$try_path" ] && IMAGE_PATH="$try_path" && break
done
for try_efi in /efiboot.img /boot/efiboot.img; do
  [ -f "$try_efi" ] && EFIBOOT_PATH="$try_efi" && break
done

if [ -z "$IMAGE_PATH" ] || [ -z "$EFIBOOT_PATH" ]; then
  for cd_dev in /dev/sr* /dev/cdrom; do
    [ -b "$cd_dev" ] || continue
    mount -o ro "$cd_dev" /mnt 2>/dev/null
    for mp in /mnt/boot/novaos.img /mnt/novaos.img; do
      [ -f "$mp" ] && [ -z "$IMAGE_PATH" ] && IMAGE_PATH="$mp"
    done
    for me in /mnt/boot/efiboot.img /mnt/efiboot.img; do
      [ -f "$me" ] && [ -z "$EFIBOOT_PATH" ] && EFIBOOT_PATH="$me"
    done
    umount /mnt 2>/dev/null || true
  done
fi

if [ -z "$IMAGE_PATH" ]; then
  xp_fail "Could not find novaos.img!"
  printf "  Starting rescue shell...\n"
  exec /bin/sh
fi

IMAGE_SIZE=$(stat -c%s "$IMAGE_PATH" 2>/dev/null || wc -c < "$IMAGE_PATH")
xp_ok "Found BIOS image: $IMAGE_PATH ($(( IMAGE_SIZE / 1024 )) KB)"

if [ -n "$EFIBOOT_PATH" ]; then
  EFI_SIZE=$(stat -c%s "$EFIBOOT_PATH" 2>/dev/null || wc -c < "$EFIBOOT_PATH")
  xp_ok "Found UEFI image: $EFIBOOT_PATH ($(( EFI_SIZE / 1024 )) KB)"
else
  xp_warn "UEFI boot image not located on CD/initramfs; BIOS boot only"
fi

printf "\n"
printf "  Press ENTER to continue... "
read -r dummy

# ═══════════════════════════════════════════════════════════════════════════
# PAGE 3 – RESOURCE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
xp_header
xp_banner "Step 2 of 5 - Resource Configuration"

# Recommend RAM
REC_RAM_MB=512
[ "$INSTALLED_RAM_MB" -ge 1024 ] && REC_RAM_MB=1024
[ "$INSTALLED_RAM_MB" -ge 4096 ] && REC_RAM_MB=2048

xp_section "Memory (RAM) Allocation"
printf "    Installed system RAM  : %s%s MB%s\n" "${BOLD}" "${INSTALLED_RAM_MB}" "${RESET}"
printf "    Recommended for NovaOS: %s%s MB%s  (min 256 MB, max %s MB)\n" "${LGREEN}" "${REC_RAM_MB}" "${RESET}" "${INSTALLED_RAM_MB}"
printf "\n"
printf "    How much RAM to allocate? [Default %s MB]: " "${REC_RAM_MB}"
read -r input_ram
[ -z "$input_ram" ] && input_ram="$REC_RAM_MB"
# Validate range
if [ "$input_ram" -lt 256 ] 2>/dev/null; then
  xp_warn "Below minimum – setting to 256 MB"
  input_ram=256
fi
if [ "$input_ram" -gt "$INSTALLED_RAM_MB" ] 2>/dev/null; then
  xp_warn "Exceeds installed RAM – capping to ${INSTALLED_RAM_MB} MB"
  input_ram=$INSTALLED_RAM_MB
fi
xp_ok "RAM allocation set to: ${input_ram} MB"

printf "\n"
printf "  Press ENTER to continue... "
read -r dummy

# ═══════════════════════════════════════════════════════════════════════════
# PAGE 4 – SELECT TARGET DISK
# ═══════════════════════════════════════════════════════════════════════════
xp_header
xp_banner "Step 3 of 5 - Select Target Disk"

xp_section "Available Hard Drives"

DISKS=""
for devpath in /sys/block/*; do
  [ -d "$devpath" ] || continue
  dname=$(basename "$devpath")
  case "$dname" in loop*|ram*|sr*|zram*|fd*) continue ;; esac
  [ -b "/dev/$dname" ] || continue
  sectors=$(cat "$devpath/size" 2>/dev/null)
  [ -z "$sectors" ] || [ "$sectors" -lt 1024 ] && continue
  DISKS="$DISKS /dev/$dname"
done

if [ -z "$DISKS" ]; then
  xp_fail "No usable hard disks found!"
  printf "  Attach a virtual hard disk and restart.\n"
  printf "  Press ENTER for rescue shell... "
  read -r dummy
  exec /bin/sh
fi

idx=1
for d in $DISKS; do
  dname=$(basename "$d")
  sec=$(cat "/sys/block/$dname/size" 2>/dev/null)
  mb=$((sec / 2048))
  gb=$((mb / 1024))
  model=""
  [ -f "/sys/block/$dname/device/model" ] && model=$(cat "/sys/block/$dname/device/model" | xargs)
  if [ "$gb" -ge 1 ]; then
    printf "    %s[%d]%s  %s  —  %s MB  (%s GB)  %s\n" "${BOLD}" "$idx" "${RESET}" "$d" "$mb" "$gb" "$model"
  else
    printf "    %s[%d]%s  %s  —  %s MB  %s\n" "${BOLD}" "$idx" "${RESET}" "$d" "$mb" "$model"
  fi
  idx=$((idx + 1))
done
printf "\n"

TARGET_DEV=""
while [ -z "$TARGET_DEV" ]; do
  printf "    Select disk [1-%d] or 'q' to quit: " "$((idx-1))"
  read -r sel
  [ "$sel" = "q" ] || [ "$sel" = "Q" ] && printf "  Aborted.\n" && exec /bin/sh
  cur=1
  for d in $DISKS; do
    [ "$sel" = "$cur" ] && TARGET_DEV="$d" && break
    cur=$((cur + 1))
  done
  [ -z "$TARGET_DEV" ] && xp_warn "Invalid selection. Try again."
done

TARGET_NAME=$(basename "$TARGET_DEV")
TARGET_SEC=$(cat "/sys/block/$TARGET_NAME/size" 2>/dev/null)
TARGET_MB=$((TARGET_SEC / 2048))
TARGET_GB=$((TARGET_MB / 1024))

xp_ok "Selected: $TARGET_DEV  ($TARGET_MB MB)"

# Storage allocation
printf "\n"
xp_section "Storage Allocation"
REC_STORE_MB=$TARGET_MB
printf "    Disk capacity           : %s%s MB%s\n" "${BOLD}" "${TARGET_MB}" "${RESET}"
printf "    Recommended allocation  : %s%s MB (full disk)%s\n" "${LGREEN}" "${REC_STORE_MB}" "${RESET}"
printf "\n"
printf "    Storage to allocate for NovaOS? [Default full %s MB]: " "${TARGET_MB}"
read -r input_store
[ -z "$input_store" ] && input_store="$TARGET_MB"
xp_ok "Storage allocation set to: ${input_store} MB"

# Component profile
printf "\n"
xp_section "Installation Profile"
printf "    [1]  %sFull Desktop%s  – Windows 10/XP-style GUI, Segoe UI, AC97 audio  %s(Recommended)%s\n" "${BOLD}" "${RESET}" "${LGREEN}" "${RESET}"
printf "    [2]  %sWorkstation%s   – Shell, tools, grounded typography\n" "${BOLD}" "${RESET}"
printf "    [3]  %sCore Minimal%s  – Lightweight kernel only\n" "${BOLD}" "${RESET}"
printf "\n"
printf "    Select profile [1-3, Default 1]: "
read -r input_profile
[ -z "$input_profile" ] && input_profile="1"
case "$input_profile" in
  1) PROFILE_NAME="Full Desktop" ;;
  2) PROFILE_NAME="Workstation"  ;;
  3) PROFILE_NAME="Core Minimal" ;;
  *) PROFILE_NAME="Full Desktop"; input_profile="1" ;;
esac
xp_ok "Profile: $PROFILE_NAME"

# Real-time clock
printf "\n"
xp_section "Date & Time (Hardware RTC)"
HW_DATE=$(date "+%A, %B %-d %Y  %H:%M:%S" 2>/dev/null || date)
printf "    Hardware clock: %s%s%s\n" "${BOLD}" "${HW_DATE}" "${RESET}"
printf "    Is this correct? [Y/n]: "
read -r time_ok
if [ "$time_ok" = "n" ] || [ "$time_ok" = "N" ]; then
  printf "    Enter date/time (YYYY-MM-DD HH:MM): "
  read -r new_dt
  date -s "$new_dt" 2>/dev/null && xp_ok "Clock updated." || xp_warn "Could not set clock."
fi

printf "\n"
printf "  Press ENTER to review summary... "
read -r dummy

# ═══════════════════════════════════════════════════════════════════════════
# PAGE 5 – CONFIRMATION & INSTALL
# ═══════════════════════════════════════════════════════════════════════════
xp_header
xp_banner "Step 4 of 5 - Installation Summary"

xp_section "Your Choices"
xp_item "Target disk:"    "$TARGET_DEV ($TARGET_MB MB)"
xp_item "RAM allocated:"  "$input_ram MB  (Installed: ${INSTALLED_RAM_MB} MB)"
xp_item "Storage:"        "$input_store MB"
xp_item "Profile:"        "$PROFILE_NAME"
xp_item "Processor:"      "$CPU_INFO"
xp_item "Boot Mode:"      "Dual BIOS + UEFI (Hybrid MBR + ESP)"

printf "\n"
printf "  %s%sWARNING: ALL DATA ON %s WILL BE DESTROYED!%s\n" "${RED}" "${BOLD}" "${TARGET_DEV}" "${RESET}"
printf "  %s  Your Windows system drive is NOT affected.%s\n" "${GRAY}" "${RESET}"
printf "\n"
printf "  Type  YES  (all caps) to confirm and begin installation: "
read -r raw_confirm
confirm=$(echo "$raw_confirm" | tr -d '\r\n\t ' | tr '[:lower:]' '[:upper:]')

if [ "$confirm" != "YES" ]; then
  printf "  %sConfirmation not matched ('%s'). Installation aborted.%s\n" "${RED}" "$raw_confirm" "${RESET}"
  printf "  Press ENTER for shell... "
  read -r dummy
  exec /bin/sh
fi

# ═══════════════════════════════════════════════════════════════════════════
# ACTUAL INSTALLATION
# ═══════════════════════════════════════════════════════════════════════════
xp_header
xp_banner "Installing NovaOS – Please Wait"

printf "\n"
printf "  %sInstalling files to %s...%s\n" "${BOLD}" "${TARGET_DEV}" "${RESET}"
printf "\n"

# Step-by-step with progress display
steps="Boot_Sector Stage2_Loader Kernel NovaFS EFI_System_Partition Verification"
step_num=0
total_steps=6

for step in $steps; do
  step_num=$((step_num + 1))
  pct=$((step_num * 100 / total_steps))
  label=$(echo "$step" | tr '_' ' ')
  progress_bar "$pct" "Writing $label..."
  sleep 0
done
printf "\n\n"

# 1. Write BIOS payload (LBA 0..1023)
dd if="$IMAGE_PATH" of="$TARGET_DEV" bs=512 count=1024 conv=notrunc,fsync 2>&1 | \
  grep -v "^$" | while IFS= read -r line; do printf "    %s\n" "$line"; done

# 2. Write UEFI payload & Partition table if available
if [ -n "$EFIBOOT_PATH" ] && [ -f "$EFIBOOT_PATH" ]; then
  # Write efiboot.img starting at LBA 2048 (1 MB offset)
  dd if="$EFIBOOT_PATH" of="$TARGET_DEV" bs=512 seek=2048 conv=notrunc,fsync 2>&1 | \
    grep -v "^$" | while IFS= read -r line; do printf "    EFI: %s\n" "$line"; done

  # Write MBR Partition Entry 1 at offset 446 of LBA 0:
  # Bootable (0x80), Start CHS (0x00,0x02,0x00), Type 0xEF (ESP), End CHS (0xFE,0xFF,0xFF),
  # Start LBA 2048 (0x00000800), Count 5760 (0x00001680)
  printf '\x80\x00\x02\x00\xef\xfe\xff\xff\x00\x08\x00\x00\x80\x16\x00\x00' | \
    dd of="$TARGET_DEV" bs=1 seek=446 count=16 conv=notrunc,fsync 2>/dev/null
  xp_ok "EFI System Partition written at LBA 2048 (Type 0xEF)"
fi
sync

# 3. Verify
printf "\n"
xp_section "Verifying Installation"
src_sum=$(dd if="$IMAGE_PATH" bs=512 skip=1 count=1023 2>/dev/null | sha256sum | awk '{print $1}')
dst_sum=$(dd if="$TARGET_DEV" bs=512 skip=1 count=1023 2>/dev/null | sha256sum | awk '{print $1}')

if [ "$src_sum" = "$dst_sum" ]; then
  xp_ok "BIOS Kernel & NovaFS verified  (SHA-256 match)"
else
  xp_fail "Checksum MISMATCH – installation may be corrupt!"
  printf "    Source: %s\n" "$src_sum"
  printf "    Dest:   %s\n" "$dst_sum"
  printf "    Press ENTER for rescue shell... "
  read -r dummy
  exec /bin/sh
fi

if [ -n "$EFIBOOT_PATH" ] && [ -f "$EFIBOOT_PATH" ]; then
  efi_src=$(head -c 2949120 "$EFIBOOT_PATH" | sha256sum | awk '{print $1}')
  efi_dst=$(dd if="$TARGET_DEV" bs=512 skip=2048 count=5760 2>/dev/null | sha256sum | awk '{print $1}')
  if [ "$efi_src" = "$efi_dst" ]; then
    xp_ok "UEFI System Partition verified  (SHA-256 match)"
  else
    xp_warn "UEFI partition checksum mismatch, but MBR boot remains functional"
  fi
fi

# ═══════════════════════════════════════════════════════════════════════════
# PAGE 6 – COMPLETE
# ═══════════════════════════════════════════════════════════════════════════
xp_header
xp_banner "Step 5 of 5 - Installation Complete!"

printf "\n"
printf "%s%s\n" "${LGREEN}" "${BOLD}"
printf "     ██████╗  ██████╗ ███╗   ██╗███████╗██╗\n"
printf "     ██╔══██╗██╔═══██╗████╗  ██║██╔════╝██║\n"
printf "     ██║  ██║██║   ██║██╔██╗ ██║█████╗  ██║\n"
printf "     ██║  ██║██║   ██║██║╚██╗██║██╔══╝  ╚═╝\n"
printf "     ██████╔╝╚██████╔╝██║ ╚████║███████╗██╗\n"
printf "     ╚═════╝  ╚═════╝ ╚═╝  ╚═══╝╚══════╝╚═╝\n"
printf "%s\n" "${RESET}"
printf "  %sNova OS 1.00 26Q4 (Build 26110.0000) successfully installed to %s!%s\n" "${BOLD}" "${TARGET_DEV}" "${RESET}"
printf "\n"
xp_section "Installation Summary"
xp_item "LBA 0       :" "Master Boot Record (boot.bin)"
xp_item "LBA 1-4     :" "Stage 2 Bootloader (stage2.bin)"
xp_item "LBA 5-132   :" "64-bit Long Mode Kernel (kernel.bin)"
xp_item "LBA 133-920 :" "NovaFS (fonts, logo, audio)"
xp_item "LBA 2048+   :" "EFI System Partition (BOOTX64.EFI)"
xp_item "Boot Mode   :" "Dual Hybrid BIOS (MBR) + UEFI (ESP)"
printf "\n"
printf "  %sNext steps:%s\n" "${BOLD}" "${RESET}"
printf "    1. Eject / unmount this installer ISO\n"
printf "    2. Set VirtualBox firmware to BIOS or EFI (both work!)\n"
printf "    3. Power on – Nova OS 1.00 26Q4 will start automatically\n"
printf "\n"
printf "  Press ENTER to reboot now... "
read -r dummy
reboot -f
